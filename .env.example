# Für compose.arcane.yaml: NAME DES BISHERIGEN /data-VOLUMES eintragen.
# Auch ein bestehendes anonymes Volume kann hier dauerhaft verwendet werden.
AG_FIT_DATA_VOLUME=hier-vorhandenen-volumenamen-eintragen
APP_URL=https://fit.agrosskopf.de
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_FROM=ag fit <noreply@agrosskopf.de>
SMTP_USER=noreply@agrosskopf.de
# Nur in Arcane/.env hinterlegen; niemals in Git einchecken.
SMTP_PASSWORD=
EMAIL_VERIFICATION_REQUIRED=true
# Bei bestehenden Konten true lassen. Nur bei einer bewusst leeren Neuinstallation false.
REQUIRE_EXISTING_DATABASE=true
